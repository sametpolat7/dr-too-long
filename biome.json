{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/extension/src/content/**",
        "apps/extension/src/entrypoints/*.content.{ts,tsx}",
        "apps/extension/src/*.{ts,tsx}"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/settings/**",
                      "**/background/**",
                      "**/options/**",
                      "wxt/utils/storage",
                      "@dr-too-long/shared/model",
                      "@dr-too-long/shared/providers"
                    ],
                    "message": "Content scripts never touch the API key or the model. The background worker owns both."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/extension/src/options/**", "apps/extension/src/entrypoints/options/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@dr-too-long/shared/model"],
                    "message": "The options page reaches the model only through the background worker's summarize port."
                  },
                  {
                    "group": ["**/settings/api-key*"],
                    "importNamePattern": "readApiKey",
                    "message": "Only the background worker decrypts the API key."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
