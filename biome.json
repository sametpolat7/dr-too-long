{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/extension/src/content/**",
        "apps/extension/src/entrypoints/*.content.{ts,tsx}",
        "apps/extension/src/*.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/settings/**",
                      "wxt/utils/storage",
                      "@dr-too-long/shared/model",
                      "@dr-too-long/shared/providers"
                    ],
                    "message": "Content scripts never touch the API key or the model. The background worker owns both."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
