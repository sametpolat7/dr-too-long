{
  "name": "dr-too-long",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.11.2",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "pnpm --filter @dr-too-long/extension dev",
    "build": "pnpm --recursive build",
    "zip": "pnpm --filter @dr-too-long/extension zip",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --recursive test",
    "check:manifest": "pnpm --filter @dr-too-long/extension check:manifest",
    "check:bundle": "pnpm --filter @dr-too-long/extension check:bundle"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "lefthook": "2.2.2"
  }
}
